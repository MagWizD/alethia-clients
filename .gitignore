# ── VSCode Extension ──────────────────────────────────────────
_vscode/alethia-extension/node_modules/
_vscode/alethia-extension/out/
_vscode/alethia-extension/dist/
_vscode/alethia-extension/*.vsix
_vscode/alethia-extension/.vscode-test/

# ── JetBrains Plugin ──────────────────────────────────────────
_jetbrains/.gradle/
_jetbrains/build/
_jetbrains/.idea/
_jetbrains/*.iml
_jetbrains/local.properties
_jetbrains/.DS_store
_jetbrains/.intellijPlatform
_jetbrains/.kotlin
_jetbrains/.run
_jetbrains/bin/

