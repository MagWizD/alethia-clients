# ── VSCode Extension ──────────────────────────────────────────
vscode/node_modules/
vscode/out/
vscode/dist/
vscode/*.vsix
vscode/.vscode-test/

# ── JetBrains Plugin ──────────────────────────────────────────
jetbrains/.gradle/
jetbrains/build/
jetbrains/.idea/
jetbrains/*.iml
jetbrains/local.properties

# ── Aletheia Runtime Files ────────────────────────────────────
