# and should never be committed to the extension repo itself
flaggedRegions.json
temp_note.json

# ── OS Files ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Environment ───────────────────────────────────────────────
.env
.env.local
*.key
*.pem

# ── Logs ──────────────────────────────────────────────────────
*.log
logs/
